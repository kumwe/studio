{
  "name": "@kumwe/studio",
  "version": "0.1.0-beta.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumwe/studio.git",
    "directory": "packages/studio-lit"
  },
  "homepage": "https://github.com/kumwe/studio/tree/main/packages/studio-lit#readme",
  "bugs": "https://github.com/kumwe/studio/issues",
  "description": "Accessible Lit Web Component shell for the Studio core engine.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third-party-licenses",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./browser-bundle": {
      "types": "./dist/browser-entry.d.ts",
      "import": "./dist/browser/studio-browser.js"
    },
    "./catalogs/en.json": "./dist/catalogs/en.json"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/build-studio-browser.mjs"
  },
  "dependencies": {
    "@kumwe/studio-core": "0.1.0-beta.2",
    "@kumwe/studio-media": "0.1.0-beta.2",
    "@kumwe/studio-preview": "0.1.0-beta.2",
    "@kumwe/studio-protocol": "0.1.0-beta.2",
    "@kumwe/studio-renderer-web": "0.1.0-beta.2",
    "@kumwe/studio-rich-text": "0.1.0-beta.2",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@kumwe/studio-testkit": "0.1.0-beta.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  }
}
