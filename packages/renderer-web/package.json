{
  "name": "@kumwe/studio-renderer-web",
  "version": "0.1.0-beta.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumwe/studio.git",
    "directory": "packages/renderer-web"
  },
  "homepage": "https://github.com/kumwe/studio/tree/main/packages/renderer-web#readme",
  "bugs": "https://github.com/kumwe/studio/issues",
  "description": "Portable semantic web renderer and trusted progressive enhancements for Studio.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third-party-licenses",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/chart-js": {
      "types": "./dist/adapters/chart-js.d.ts",
      "import": "./dist/adapters/chart-js.js"
    },
    "./adapters/katex": {
      "types": "./dist/adapters/katex.d.ts",
      "import": "./dist/adapters/katex.js"
    },
    "./adapters/mermaid": {
      "types": "./dist/adapters/mermaid.d.ts",
      "import": "./dist/adapters/mermaid.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/minify-package-dist.mjs --package packages/renderer-web && node ../../scripts/build-studio-enhancement-runtime.mjs"
  },
  "dependencies": {
    "@kumwe/studio-core": "0.1.0-beta.2",
    "@kumwe/studio-protocol": "0.1.0-beta.2",
    "@kumwe/studio-rich-text": "0.1.0-beta.2"
  },
  "peerDependencies": {
    "chart.js": "4.5.1",
    "katex": "0.18.4",
    "mermaid": "11.17.1"
  },
  "peerDependenciesMeta": {
    "chart.js": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  }
}
