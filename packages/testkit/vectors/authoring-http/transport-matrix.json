  "securityCases": [
    {
      "id": "accepted",
      "authenticated": true,
      "requestIntegrity": true,
      "request": "valid",
      "expect": { "outcome": "result", "status": 200, "dispatch": true }
    },
    {
      "id": "unauthenticated",
      "authenticated": false,
      "requestIntegrity": true,
      "request": "valid",
      "expect": {
        "outcome": "error",
        "status": 401,
        "category": "unauthenticated",
        "dispatch": false
      }
    },
    {
      "id": "csrf-refused",
      "authenticated": true,
      "requestIntegrity": false,
      "request": "valid",
      "expect": { "outcome": "error", "status": 403, "category": "forbidden", "dispatch": false }
    },
    {
      "id": "malformed-json",
      "authenticated": true,
      "requestIntegrity": true,
      "request": "malformed-json",
      "expect": {
        "outcome": "error",
        "status": 400,
        "category": "invalid-request",
        "dispatch": false
      }
    },
    {
      "id": "context-mismatch",
      "authenticated": true,
      "requestIntegrity": true,
      "request": "context-mismatch",
      "expect": {
        "outcome": "error",
        "status": 400,
        "category": "invalid-request",
        "dispatch": false
      }
    },
    {
      "id": "missing-idempotency",
      "authenticated": true,
      "requestIntegrity": true,
      "request": "missing-idempotency-key",
      "expect": {
        "outcome": "error",
        "status": 400,
        "category": "invalid-request",
        "dispatch": false
      }
    },
    {
      "id": "wrong-operation",
      "authenticated": true,
      "requestIntegrity": true,
      "request": "wrong-operation-id",
      "expect": {
        "outcome": "error",
        "status": 400,
        "category": "invalid-request",
        "dispatch": false
      }
    },
    {
      "id": "host-conflict",
      "authenticated": true,
      "requestIntegrity": true,
      "request": "host-conflict",
      "expect": { "outcome": "error", "status": 409, "category": "conflict", "dispatch": true }
    },
    {
      "id": "host-rate-limited",
      "authenticated": true,
      "requestIntegrity": true,
      "request": "host-rate-limited",
      "expect": {
        "outcome": "error",
        "status": 429,
        "category": "rate-limited",
        "dispatch": true
      }
    },
    {
      "id": "host-internal",
      "authenticated": true,
      "requestIntegrity": true,
      "request": "host-internal-failure",
      "expect": { "outcome": "error", "status": 500, "category": "internal", "dispatch": true }
    }
