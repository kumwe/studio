{
  "name": "@kumwe/studio-testkit",
  "version": "0.1.0-alpha.1",
  "description": "Draft canonical fixtures, builders, and the initial Blueprint assertion for Studio.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "conformance",
    "dist",
    "fixtures",
    "invalid",
    "README.md",
    "vectors"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance/*": "./conformance/*",
    "./fixtures/*": "./fixtures/*",
    "./invalid/*": "./invalid/*",
    "./vectors/*": "./vectors/*"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@kumwe/studio-core": "0.1.0-alpha.1",
    "@kumwe/studio-protocol": "0.1.0-alpha.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  }
}
