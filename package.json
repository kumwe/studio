{
  "name": "@kumwe/studio-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-neutral contracts and Lit authoring surfaces for Kumwe Studio.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace @kumwe/studio-reference-host",
    "changeset": "changeset",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run contracts:check && npm run test && npm run build",
    "check:a11y": "npm run build && playwright test --config e2e/playwright.config.ts",
    "clean": "node scripts/clean.mjs",
    "contracts:check": "node scripts/check-boundaries.mjs && node scripts/check-contracts.mjs && npm run protocol:models:check && node scripts/check-messages.mjs && node scripts/check-release-record.mjs && node scripts/check-release-pins.mjs && node scripts/check-third-party-notices.mjs && node scripts/check-packages.mjs && node scripts/check-evidence.mjs && node scripts/check-secrets.mjs && node scripts/check-requirements.mjs && node scripts/check-threats.mjs && node scripts/check-changesets.mjs",
    "contracts:sync": "node scripts/sync-schemas.mjs && npm run protocol:models:generate && node scripts/sync-release-record.mjs",
    "dev": "npm run dev --workspace @kumwe/studio-reference-host",
    "doctor": "node scripts/doctor.mjs",
    "evidence:assemble": "node scripts/assemble-evidence-bundle.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "licenses:check": "node scripts/check-third-party-notices.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "preview": "npm run preview --workspace @kumwe/studio-reference-host",
    "protocol:models:check": "node scripts/generate-typescript-models.mjs --check",
    "protocol:models:generate": "node scripts/generate-typescript-models.mjs",
    "release:check": "node scripts/check-release-record.mjs",
    "release:check-pins": "node scripts/check-release-pins.mjs",
    "release:cleanup-staging": "node scripts/cleanup-staging-tags.mjs",
    "release:artifacts": "node scripts/release-artifacts.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release:promotion-plan": "node scripts/promotion-plan.mjs",
    "release:prepare": "node scripts/prepare-promotion.mjs",
    "release:publish-alpha": "node scripts/publish-alpha.mjs",
    "release:publish": "node scripts/publish-promotion.mjs",
    "release:publish-stage": "node scripts/publish-staged-candidate.mjs",
    "release:readiness": "node scripts/verify-release-gate.mjs && npm run check",
    "release:reconcile-tag": "node scripts/reconcile-release-tag.mjs",
    "release:sync": "node scripts/sync-release-record.mjs",
    "release:verify-published": "node scripts/verify-published-release.mjs",
    "release:verify-stage": "node scripts/verify-staged-release.mjs",
    "start": "npm run build && npm run preview",
    "test": "vitest run --coverage.enabled=false && node --test scripts/test/*.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "verify": "npm run check && npm run check:a11y",
    "version-packages": "node scripts/version-packages.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@cyclonedx/cyclonedx-library": "10.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "happy-dom": "20.11.2",
    "playwright-core": "1.56.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
