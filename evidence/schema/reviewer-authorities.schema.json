{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kumwe.org/studio/evidence/reviewer-authorities.schema.json",
  "title": "Studio reviewer authority registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorities", "contractVersion", "kind", "status"],
  "properties": {
    "authorities": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "independent", "publicKeys", "roles"],
        "properties": {
          "identity": { "$ref": "#/$defs/identity" },
          "independent": { "type": "boolean" },
          "publicKeys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/sshEd25519PublicKey" }
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": ["general", "accessibility", "compatibility", "data-integrity", "security"]
            }
          }
        }
      }
    },
    "contractVersion": { "const": "0.1-draft" },
    "kind": { "const": "reviewer-authority-registry" },
    "status": { "enum": ["input-required", "active"] }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^github/[1-9][0-9]{0,19}/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?(?![\\s\\S])",
      "maxLength": 80
    },
    "sshEd25519PublicKey": {
      "type": "string",
      "pattern": "^ssh-ed25519 [A-Za-z0-9+/]{40,120}={0,2}(?![\\s\\S])",
      "maxLength": 140
    }
  }
}
