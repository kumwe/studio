{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kumwe.org/studio/evidence/gate-record.schema.json",
  "title": "Studio gate decision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactHashes",
    "compatibilityStatement",
    "decidedAt",
    "decision",
    "evidenceSchemaVersion",
    "criteria",
    "evidenceBundleIds",
    "excludedProfiles",
    "gate",
    "reviewers",
    "signOff",
    "sourceCommit",
    "supportedProfiles",
    "unresolvedDefects"
  ],
  "properties": {
    "artifactHashes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2000,
      "propertyNames": { "$ref": "#/$defs/repositoryRelativePath" },
      "additionalProperties": { "$ref": "#/$defs/sha256Integrity" }
    },
    "compatibilityStatement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "decidedAt": { "$ref": "#/$defs/rfc3339Timestamp" },
    "decision": { "enum": ["pass", "fail"] },
    "evidenceSchemaVersion": { "const": "0.1-draft" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "evidenceBundleIds", "outcome"],
        "properties": {
          "criterionId": { "$ref": "#/$defs/stableId" },
          "evidenceBundleIds": { "$ref": "#/$defs/bundleIdList" },
          "outcome": { "enum": ["met", "not-met", "not-assessed"] }
        }
      }
    },
    "evidenceBundleIds": { "$ref": "#/$defs/bundleIdList" },
    "excludedProfiles": { "$ref": "#/$defs/profileList" },
    "gate": { "enum": ["A", "B"] },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/gateReviewer" }
    },
    "signOff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessibility", "compatibility", "dataIntegrity", "security"],
      "properties": {
        "accessibility": { "$ref": "#/$defs/identity" },
        "compatibility": { "$ref": "#/$defs/identity" },
        "dataIntegrity": { "$ref": "#/$defs/identity" },
        "security": { "$ref": "#/$defs/identity" }
      }
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}(?![\\s\\S])",
      "maxLength": 40
    },
    "supportedProfiles": { "$ref": "#/$defs/profileList" },
    "unresolvedDefects": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rationale", "severity"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "severity": { "enum": ["low", "medium", "high", "critical"] }
        }
      }
    }
  },
  "$defs": {
    "bundleIdList": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])",
        "maxLength": 120
      }
    },
    "gateReviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "independent", "kind", "roles"],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "independent": { "type": "boolean" },
        "kind": { "const": "human" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["general", "accessibility", "compatibility", "data-integrity", "security"]
          }
        }
      }
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+(?![\\s\\S])"
    },
    "profileList": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^studio\\.profile/[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])",
        "maxLength": 160
      }
    },
    "repositoryRelativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9@][A-Za-z0-9._@-]*(?:/[A-Za-z0-9@][A-Za-z0-9._@-]*)*(?![\\s\\S])",
      "maxLength": 240
    },
    "rfc3339Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])",
      "maxLength": 40
    },
    "sha256Integrity": {
      "type": "string",
      "pattern": "^sha256-[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=(?![\\s\\S])",
      "maxLength": 60
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])",
      "not": { "enum": ["__proto__", "prototype", "constructor"] },
      "maxLength": 240
    }
  }
}
